# Minimal env file for `docker compose up -d --build`.
# Copy to .env, fill in real values, and never commit the result.
#
# See .env.example for the full list of supported providers and options.

# ==================== Server ====================
HOST=0.0.0.0
PORT=8082
FCC_OPEN_BROWSER=false

# ==================== Default routed model ====================
# Format: provider_type/model/name
MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b

# ==================== Providers (single-key, backward compatible) ====================
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=

# ==================== Multi-key providers (optional) ====================
# JSON object mapping provider id to a list of ADDITIONAL upstream keys, used
# in round-robin alongside the single-key fields above.
# PROVIDER_API_KEYS={"nvidia_nim": ["nvapi-key-2"], "groq": ["gsk-key-2"]}

# ==================== Proxy authentication ====================
PROXY_AUTH_ENABLED=true
ANTHROPIC_AUTH_TOKEN=fcc_change_me
# Additional public/downstream API keys; any one authenticates a client.
PUBLIC_API_KEYS=fcc_test_1,fcc_test_2
